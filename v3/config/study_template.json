  "burn_in_epochs": 0,
  "compare_metric": "adaptation_score",
  "bootstrap": true,
  "n_bootstrap": 2000,
  "quantiles": [0.1, 0.9],
  "workers": null,
  "early_stop_all_extinct": true,
  "save_end_checkpoints": false
}
